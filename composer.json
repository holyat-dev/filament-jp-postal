{
    "name": "holyat/filament-jp-postal",
    "description": "Japanese postal code (郵便番号) address auto-fill for Filament: a postal code input that fills 都道府県・市区町村・町域, a prefecture select, and zipcloud / Japan Post data drivers.",
    "keywords": [
        "filament",
        "laravel",
        "japan",
        "postal-code",
        "郵便番号"
    ],
    "homepage": "https://github.com/holyat-dev/filament-jp-postal",
    "support": {
        "issues": "https://github.com/holyat-dev/filament-jp-postal/issues",
        "source": "https://github.com/holyat-dev/filament-jp-postal"
    },
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Holyat",
            "homepage": "https://github.com/holyat-dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "ext-zip": "Required to import the ZIP file published by Japan Post (jp-postal:import)."
    },
    "autoload": {
        "psr-4": {
            "Holyat\\FilamentJpPostal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Holyat\\FilamentJpPostal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Holyat\\FilamentJpPostal\\FilamentJpPostalServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
